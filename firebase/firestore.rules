rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Product data and price history are written only by Cloud Functions.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /history/{pointId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /users/{uid} {
      // The app stores its FCM push tokens here.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fcmTokens', 'updatedAt'])
        && request.resource.data.fcmTokens is list
        && request.resource.data.fcmTokens.size() <= 10;

      // Watchlist: readable by its owner, changed only through trackProduct/untrackProduct.
      match /tracked/{productId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
  }
}
