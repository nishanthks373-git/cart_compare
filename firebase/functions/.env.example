# Copy to .env (same folder) and fill in what you want. Everything here is optional.

# Price comparison across ALL Indian stores via Google Shopping (https://serpapi.com).
# Without it, comparison searches Amazon.in and Flipkart directly.
SERPAPI_KEY=

# Backfill up to 1 year of Amazon.in price history the first time a product is looked up (https://keepa.com/#!api).
KEEPA_API_KEY=

# Scraping service used when a store blocks Google Cloud IPs. Must contain {url}.
# Example (ScraperAPI): https://api.scraperapi.com/?api_key=YOUR_KEY&country_code=in&url={url}
SCRAPER_PROXY_URL=

# Tuning
REFRESH_SCHEDULE=every 6 hours
REFRESH_BATCH=150
COMPARE_REFRESH_HOURS=24
MATCH_MIN_SCORE=0.55
MAX_TRACKED_PER_USER=50
